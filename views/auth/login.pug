extends ../layout/iniciar-sesion

block contenido
  div(class="flex justify-center items-center py-16 px-4 min-h-screen")

    // ===== CARD PRINCIPAL =====
    div(class="bg-white shadow-2xl rounded-2xl max-w-4xl w-full flex overflow-hidden")

      // ===== IZQUIERDA: TITULO =====
      div(class="w-1/2 bg-gray-800 flex flex-col justify-center items-center p-10 text-white")
        h1(class="text-4xl font-bold mb-4 flex items-center gap-2")
          i(class="fa fa-users text-white text-3xl")
          | Grupo
          span(class="font-normal") Castores
        h2(class="text-xl font-semibold text-gray-100 mt-2")= pagina
        p(class="mt-6 text-gray-200 text-center") Bienvenido! Inicia sesión para continuar

      // ===== DERECHA: FORMULARIO =====
      div(class="w-1/2 p-10")
        if errores
          div(class="mb-4 space-y-2")
            each error in errores
              p(class="bg-red-500 text-white uppercase text-xs text-center py-2 px-3 rounded shadow")= error.msg

        form(method="POST" class="space-y-6")
          
          // EMAIL
          div
            label(class="block text-sm font-semibold text-gray-600 mb-2 flex items-center gap-2" for="email")
              i(class="fa fa-envelope text-gray-400")
              | Email
            input(
              id="email"
              type="email"
              name="email"
              placeholder="Tu email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-600 focus:border-transparent transition"
            )

          // PASSWORD
          div
            label(class="block text-sm font-semibold text-gray-600 mb-2 flex items-center gap-2" for="password")
              i(class="fa fa-lock text-gray-400")
              | Password
            input(
              id="password"
              type="password"
              name="password"
              placeholder="Tu password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-600 focus:border-transparent transition"
            )

          // BOTON
          input(
            type="submit"
            value="Iniciar Sesión"
            class="w-full py-3 bg-gray-700 hover:bg-gray-800 text-white font-bold rounded-lg cursor-pointer transition shadow-md"
          )