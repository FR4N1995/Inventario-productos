extends ../layout/admin

block contenido
  .py-10
    h1(class="text-4xl my-7 font-bold text-center flex items-center justify-center gap-2")
      i(class="fa fa-box-open text-green-600")
      | Grupo 
      span(class="font-normal") Castores

    h2(class="text-center text-2xl font-extrabold text-gray-700 mb-6")= pagina

    if usuario.admin === 1
      a(
        href='/administrador/crearProducto'
        class="rounded py-2 px-10 bg-green-600 hover:bg-green-700 text-sm font-bold text-white text-center my-5 inline-block w-full sm:w-auto flex items-center justify-center gap-2 transition shadow"
      )
        i(class="fa fa-plus")
        | Agregar Producto

    if productos.length
      div(class="overflow-x-auto bg-white shadow-lg rounded-xl mt-4")
        table(class="min-w-full divide-y divide-gray-200")
          thead(class="bg-gray-200")
            tr
              th(class="px-6 py-3 text-left text-xs font-medium text-gray-800 uppercase tracking-wider") Nombre
              th(class="px-6 py-3 text-left text-xs font-medium text-gray-800 uppercase tracking-wider") Cantidad
              th(class="px-6 py-3 text-left text-xs font-medium text-gray-800 uppercase tracking-wider") Acciones

          tbody(class="bg-white divide-y divide-gray-200")
            each producto in productos
              tr
                // Columna Nombre
                td(class="px-6 py-4 whitespace-nowrap text-gray-700 text-lg  items-center gap-2")
                    i(class="fa fa-box text-gray-400 gap-3")
                    span(class="nombreProducto ")= producto.nombre


                // Columna Cantidad
                td(class="px-6 py-4 whitespace-nowrap text-gray-700 text-lg  items-center gap-2")
                    i(class="fa fa-layer-group text-gray-400")
                    span(class="cantidadProducto")= producto.cantidad

                // Columna Acciones
                td(class="px-6 py-4 whitespace-nowrap flex flex-wrap gap-2 opciones")
                  // Estado
                  if usuario.admin === 1
                    button(
                      type="button"
                      data-producto-id=`${producto.id}`
                      class=`${producto.estado ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'} cambiar-estado px-4 py-2 cursor-pointer font-semibold rounded text-sm flex items-center gap-4`
                    )
                      i(class=`fa ${producto.estado ? 'fa-check-circle' : 'fa-exclamation-circle'}`)
                      | #{producto.estado ? 'Alta' : 'Baja'}
                  else
                    button(
                      type="button"
                      data-producto-id=`${producto.id}`
                      class=`${producto.estado ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'} cambiar-estado px-4 py-2 cursor-not-allowed font-semibold rounded text-sm flex items-center gap-1 opacity-50`
                      disabled
                    )
                      i(class=`fa ${producto.estado ? 'fa-check-circle' : 'fa-exclamation-circle'}`)
                      | #{producto.estado ? 'Alta' : 'Baja'}

                  // Entrada
                  //- p= typeof producto.estado
                  if usuario.admin !== 1 || !producto.estado
                    span(class="inline-flex items-center px-4 py-2 bg-indigo-100 text-indigo-800 rounded text-sm font-semibold gap-1 opacity-50 cursor-not-allowed")
                      i(class="fa fa-arrow-down")
                      | Entrada
                  else
                    a(
                      href=`/administrador/entrada/${producto.id}`
                      class="inline-flex items-center px-4 py-2 bg-indigo-100 text-indigo-800 rounded text-sm font-semibold gap-1 hover:bg-indigo-200 transition"
                    )
                      i(class="fa fa-arrow-down")
                      | Entrada

                  // Salida
                  if usuario.admin === 1
                    span(class="inline-flex items-center px-4 py-2 bg-red-100 text-red-800 rounded text-sm font-semibold gap-1 opacity-50 cursor-not-allowed")
                      i(class="fa fa-arrow-up")
                      | Salida
                  else
                    a(
                      href=`/administrador/salida/${producto.id}`
                      class="inline-flex items-center px-4 py-2 bg-red-100 text-red-800 rounded text-sm font-semibold gap-1 hover:bg-red-200 transition"
                    )
                      i(class="fa fa-arrow-up")
                      | Salida
        // ===== PAGINACION =====
        div(class="px-4 py-3 flex items-center justify-between border-t border-gray-200")

          div(class="flex-1 flex justify-between sm:hidden")
            a(
              href=`/administrador/historial?pagina=${paginaActual - 1}`
              class=`${paginaActual === "1" ? "pointer-events-none opacity-50" : ""} px-4 py-2 border rounded-md text-sm bg-white`
            ) Anterior

            a(
              href=`/administrador/historial?pagina=${paginaActual + 1}`
              class=`${paginaActual === paginas ? "pointer-events-none opacity-50" : ""} px-4 py-2 border rounded-md text-sm bg-white`
            ) Siguiente

          div(class="hidden sm:flex sm:items-center sm:justify-between w-full")

            p(class="text-sm text-gray-600")
              span.font-medium #{offset + 1}
              |  a 
              span.font-medium #{total < limit + offset ? total : limit + offset}
              |  de 
              span.font-medium #{total} resultados

            nav(class="inline-flex rounded-md shadow-sm")
              - var n = 1
              while n <= paginas
                a(
                  href=`/administrador/home?pagina=${n}`
                  class=`${paginaActual == n ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'} px-4 py-2 border text-sm`
                ) #{n++}


    else
      p(class="text-center text-gray-500") Todavía no tienes Productos, empieza creando uno

block scripts
  script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
  script(src="/js/cambiarEstado.js")
  script(src="/js/menuHamburguesa.js")