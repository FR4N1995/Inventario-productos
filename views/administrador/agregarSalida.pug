extends ../layout/admin

block contenido 
  .py-10 

    // ===== TITULO =====
    h1(class="text-4xl my-7 font-bold text-center flex items-center justify-center gap-2")
      i(class="fa fa-arrow-up text-red-600")
      | Grupo 
      span(class="font-normal") Castores

    h2(class="text-center text-2xl font-extrabold text-gray-700")= pagina

    // ===== ERRORES =====
    if errores 
      div(class="max-w-md mx-auto my-6 space-y-2")
        each error in errores 
          p(class="bg-red-500 text-white text-sm text-center py-2 px-3 rounded-md font-semibold shadow")
            i(class="fa fa-circle-exclamation mr-2")
            = error.msg

    // ===== BOTON VOLVER =====
    div(class="flex justify-center mt-4")
      a(
        href="/administrador/home"
        class="inline-flex items-center gap-2 rounded-lg py-2 px-6 bg-gray-700 hover:bg-gray-800 text-sm font-bold text-white transition shadow"
      )
        i(class="fa fa-arrow-left")
        | Volver

    // ===== CARD FORM =====
    div(class="bg-white shadow-xl py-10 px-6 rounded-2xl mx-auto max-w-3xl my-10 md:px-10")

      form(method="POST" class="space-y-8") 

        .space-y-6 

          // TITULO SECCION
          div
            h3(class="text-xl font-semibold text-gray-800 flex items-center gap-2")
              i(class="fa fa-box text-red-500")
              | Información General
            p(class="text-gray-500 text-sm mt-1") Agrega salida de producto

          // INPUT CANTIDAD
          div(class="flex flex-col")
            label(
              for="cantidad"
              class="text-sm font-semibold text-gray-600 mb-2 flex items-center gap-1"
            )
              i(class="fa fa-layer-group text-gray-400")
              | Cantidad

            input#cantidad(
              type="number"
              name="cantidad"
              placeholder="Ej. 7"
              value = datos.cantidad ? datos.cantidad : ''
              class="w-full px-4 py-3 border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
            )

        // ===== BOTON =====
        div(class="pt-4")
          input(
            type="submit"
            value="Agregar Salida Producto"
            class="w-full py-3 bg-red-600 hover:bg-red-700 rounded-lg text-white font-bold uppercase cursor-pointer transition shadow-md"
          )